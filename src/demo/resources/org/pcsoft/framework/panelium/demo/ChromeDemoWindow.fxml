<!--
  MenuChromePane demo: a docked FXMenuPane ribbon (Home / Tools) sits below the caption bar, its
  File tab opens a backstage overlay over the body, and the body keeps the four navigation pages in
  a TabPane plus the status bar. The ribbon groups carry the commands that used to live in the
  stand-alone ToolBar. Blue, glossy accents come from chrome-demo-menu.css, added to the Scene by
  ChromeDemoApp.
-->
<MenuChromePane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
                fx:id="chromePane"
                fx:controller="org.pcsoft.framework.panelium.demo.ChromeDemoWindowController">
    <captionLeftItems>
        <Separator>
            <padding>
                <Insets right="2.0" left="6.0"/>
            </padding>
        </Separator>
        <Button styleClass="demo-caption-button" style="-fx-background-color: transparent; -fx-padding: 3 6 3 6; -fx-background-radius: 4;" focusTraversable="false">
            <graphic>
                <ImageView fitWidth="16.0" fitHeight="16.0" preserveRatio="true">
                    <Image url="@icons/folder-16.png"/>
                </ImageView>
            </graphic>
            <tooltip>
                <Tooltip text="Open location"/>
            </tooltip>
        </Button>
        <Button styleClass="demo-caption-button" style="-fx-background-color: transparent; -fx-padding: 3 6 3 6; -fx-background-radius: 4;" focusTraversable="false">
            <graphic>
                <ImageView fitWidth="16.0" fitHeight="16.0" preserveRatio="true">
                    <Image url="@icons/new-doc-16.png"/>
                </ImageView>
            </graphic>
            <tooltip>
                <Tooltip text="New document"/>
            </tooltip>
        </Button>
        <Button styleClass="demo-caption-button" style="-fx-background-color: transparent; -fx-padding: 3 6 3 6; -fx-background-radius: 4;" focusTraversable="false">
            <graphic>
                <ImageView fitWidth="16.0" fitHeight="16.0" preserveRatio="true">
                    <Image url="@icons/view-16.png"/>
                </ImageView>
            </graphic>
            <tooltip>
                <Tooltip text="Toggle preview"/>
            </tooltip>
        </Button>
    </captionLeftItems>
    <captionCenterItems>
        <HBox alignment="CENTER" spacing="12.0">
            <HBox alignment="CENTER" spacing="6.0" styleClass="demo-brand">
                <ImageView fitWidth="16.0" fitHeight="16.0" preserveRatio="true">
                    <Image url="@icons/swoosh-16.png"/>
                </ImageView>
                <Label text="Showcase workspace"/>
            </HBox>
            <Label text="OS:"/>
            <ComboBox fx:id="osSelector">
                <tooltip>
                    <Tooltip text="Caption OS design"/>
                </tooltip>
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <ChromeOs fx:value="WINDOWS"/>
                        <ChromeOs fx:value="MAC"/>
                        <ChromeOs fx:value="LINUX"/>
                        <ChromeOs fx:value="OTHER"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </HBox>
    </captionCenterItems>
    <captionRightItems>
        <Button styleClass="demo-caption-button" style="-fx-background-color: transparent; -fx-padding: 3 6 3 6; -fx-background-radius: 4;" focusTraversable="false">
            <graphic>
                <ImageView fitWidth="16.0" fitHeight="16.0" preserveRatio="true">
                    <Image url="@icons/grid-16.png"/>
                </ImageView>
            </graphic>
            <tooltip>
                <Tooltip text="Layout"/>
            </tooltip>
        </Button>
        <Button styleClass="demo-caption-button" style="-fx-background-color: transparent; -fx-padding: 3 6 3 6; -fx-background-radius: 4;" focusTraversable="false">
            <graphic>
                <ImageView fitWidth="16.0" fitHeight="16.0" preserveRatio="true">
                    <Image url="@icons/settings-16.png"/>
                </ImageView>
            </graphic>
            <tooltip>
                <Tooltip text="Settings"/>
            </tooltip>
        </Button>
    </captionRightItems>

    <menuPane>
        <FXMenuPane fx:id="menuPane">
            <fileTab>
                <FXMenuTab id="file" title="File"/>
            </fileTab>
            <backstageContent>
                <FXBackstageMenuPane fx:id="backstageMenuPane" menuWidth="180.0" styleClass="demo-backstage">
                    <items>
                        <FXBackstageMenuItem text="Info">
                            <content>
                                <VBox spacing="8.0">
                                    <padding>
                                        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
                                    </padding>
                                    <Label text="Info" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                                    <Label text="Click the File tab to open this panel; press Escape or click outside to close."/>
                                </VBox>
                            </content>
                        </FXBackstageMenuItem>
                        <FXBackstageMenuItem text="Open">
                            <content>
                                <VBox spacing="8.0">
                                    <padding>
                                        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
                                    </padding>
                                    <Label text="Open" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                                    <Label text="Placeholder content for the Open menu entry."/>
                                </VBox>
                            </content>
                        </FXBackstageMenuItem>
                        <FXBackstageMenuItem text="Settings">
                            <content>
                                <VBox spacing="8.0">
                                    <padding>
                                        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
                                    </padding>
                                    <Label text="Settings" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                                    <Label text="Placeholder content for the Settings menu entry."/>
                                </VBox>
                            </content>
                        </FXBackstageMenuItem>
                    </items>
                </FXBackstageMenuPane>
            </backstageContent>

            <tabs>
                <FXMenuTab fx:id="home" id="home" title="Home">
                    <groups>
                        <FXMenuGroup title="New">
                            <content>
                                <FXMenuGroupLargeBox fx:id="homeNew">
                                    <Button text="New">
                                        <graphic>
                                            <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                                                <Image url="@icons/new-doc-20.png"/>
                                            </ImageView>
                                        </graphic>
                                    </Button>
                                </FXMenuGroupLargeBox>
                            </content>
                            <anchor>
                                <fx:reference source="homeNew"/>
                            </anchor>
                        </FXMenuGroup>
                        <FXMenuGroup title="Files">
                            <content>
                                <FXMenuGroupSmallBox fx:id="homeFiles">
                                    <Button text="Open">
                                        <graphic>
                                            <ImageView fitWidth="16.0" fitHeight="16.0" preserveRatio="true">
                                                <Image url="@icons/folder-16.png"/>
                                            </ImageView>
                                        </graphic>
                                    </Button>
                                    <Button text="Preview">
                                        <graphic>
                                            <ImageView fitWidth="16.0" fitHeight="16.0" preserveRatio="true">
                                                <Image url="@icons/view-16.png"/>
                                            </ImageView>
                                        </graphic>
                                    </Button>
                                </FXMenuGroupSmallBox>
                            </content>
                            <anchor>
                                <fx:reference source="homeFiles"/>
                            </anchor>
                        </FXMenuGroup>
                        <FXMenuGroup title="View">
                            <content>
                                <FXMenuGroupSmallBox fx:id="homeView">
                                    <Button text="List">
                                        <graphic>
                                            <ImageView fitWidth="16.0" fitHeight="16.0" preserveRatio="true">
                                                <Image url="@icons/list-16.png"/>
                                            </ImageView>
                                        </graphic>
                                    </Button>
                                    <Button text="Grid">
                                        <graphic>
                                            <ImageView fitWidth="16.0" fitHeight="16.0" preserveRatio="true">
                                                <Image url="@icons/grid-16.png"/>
                                            </ImageView>
                                        </graphic>
                                    </Button>
                                </FXMenuGroupSmallBox>
                            </content>
                            <anchor>
                                <fx:reference source="homeView"/>
                            </anchor>
                        </FXMenuGroup>
                    </groups>
                </FXMenuTab>

                <FXMenuTab id="tools" title="Tools">
                    <groups>
                        <FXMenuGroup title="Tools">
                            <content>
                                <FXMenuGroupLargeBox fx:id="toolsMain">
                                    <Button text="Tools">
                                        <graphic>
                                            <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                                                <Image url="@icons/tools-20.png"/>
                                            </ImageView>
                                        </graphic>
                                    </Button>
                                </FXMenuGroupLargeBox>
                            </content>
                            <anchor>
                                <fx:reference source="toolsMain"/>
                            </anchor>
                        </FXMenuGroup>
                        <FXMenuGroup title="Settings">
                            <content>
                                <FXMenuGroupLargeBox fx:id="toolsSettings">
                                    <Button text="Settings">
                                        <graphic>
                                            <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                                                <Image url="@icons/settings-20.png"/>
                                            </ImageView>
                                        </graphic>
                                    </Button>
                                </FXMenuGroupLargeBox>
                            </content>
                            <anchor>
                                <fx:reference source="toolsSettings"/>
                            </anchor>
                        </FXMenuGroup>
                    </groups>
                </FXMenuTab>
            </tabs>

            <activeTab>
                <fx:reference source="home"/>
            </activeTab>

            <!-- Trailing items: host action buttons at the tab-strip row's trailing edge, before
                 the collapse/expand chevron - mirrors the Comments/Edit/Share buttons shown next to
                 the ribbon tabs in Word. -->
            <trailingItems>
                <Button fx:id="previewButton" text="Preview" styleClass="menu-pane-trailing-button" focusTraversable="false">
                    <graphic>
                        <ImageView fitWidth="16.0" fitHeight="16.0" preserveRatio="true">
                            <Image url="@icons/view-16.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="shareButton" text="Share"
                        styleClass="menu-pane-trailing-button,menu-pane-trailing-button-accent" focusTraversable="false"/>
            </trailingItems>
        </FXMenuPane>
    </menuPane>

    <VBox style="-fx-background-color: white;">
        <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
            <Tab text="Start">
                <graphic>
                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                        <Image url="@icons/home-20.png"/>
                    </ImageView>
                </graphic>
                <fx:include source="pages/StartPage.fxml"/>
            </Tab>
            <Tab text="Documents">
                <graphic>
                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                        <Image url="@icons/folder-20.png"/>
                    </ImageView>
                </graphic>
                <fx:include source="pages/DocumentsPage.fxml"/>
            </Tab>
            <Tab text="Chrome options">
                <graphic>
                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                        <Image url="@icons/tools-20.png"/>
                    </ImageView>
                </graphic>
                <fx:include fx:id="chromeOptionsPage" source="pages/ChromeOptionsPage.fxml"/>
            </Tab>
            <Tab text="Settings">
                <graphic>
                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                        <Image url="@icons/settings-20.png"/>
                    </ImageView>
                </graphic>
                <fx:include source="pages/SettingsPage.fxml"/>
            </Tab>
        </TabPane>

        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="demo-status-bar" style="-fx-background-color: #f2f5fb; -fx-border-color: #d9e2f2; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="6.0" right="12.0" bottom="6.0" left="12.0"/>
            </padding>
            <ImageView fitWidth="16.0" fitHeight="16.0" preserveRatio="true">
                <Image url="@icons/swoosh-16.png"/>
            </ImageView>
            <Label text="Ready"/>
            <Label fx:id="backstageSelectionLabel" text="Backstage selection: none"/>
            <Label fx:id="backstageQuickActionLabel" text="Backstage quick action: not fired yet"/>
            <Label fx:id="trailingItemActionLabel" text="Trailing item action: not fired yet"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="PaneliumFX • undecorated stage"/>
        </HBox>
    </VBox>
</MenuChromePane>
