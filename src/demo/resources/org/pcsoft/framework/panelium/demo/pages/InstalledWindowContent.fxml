<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      alignment="CENTER" spacing="10.0" style="-fx-background-color: white; -fx-padding: 24;">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>
    <ImageView fitWidth="48.0" fitHeight="48.0" preserveRatio="true">
        <image>
            <Image url="@../icons/app-48.png"/>
        </image>
    </ImageView>
    <Label text="Opened via PaneliumChrome.install(stage)"/>
</VBox>
