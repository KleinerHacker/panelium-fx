<!--
  Rebuild of docs/docs/assets/images/logo.png as a live PaneliumFX window: a dark-blue caption with
  the swoosh mark, a real FXMenuPane ribbon (Home/View/Tools) docked below it, a File tab backstage
  overlay, and a list sidebar next to a glossy content canvas as the window body. Themed by
  logo-theme.css, launched by LogoShowcaseApp. The ribbon groups reproduce the icon row from the
  logo (new document, folder, list, grid, framed settings). LogoShowcaseWindowController wires the
  backstage's quick action footer.
-->
<MenuChromePane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
                fx:controller="org.pcsoft.framework.panelium.demo.LogoShowcaseWindowController"
                defaultTitleVisible="false" defaultIconVisible="false">
    <captionLeftItems>
        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="logo-brand">
            <padding>
                <Insets left="10.0"/>
            </padding>
            <ImageView fitWidth="18.0" fitHeight="18.0" preserveRatio="true">
                <Image url="@icons/swoosh-24.png"/>
            </ImageView>
            <Label text="PaneliumFX"/>
        </HBox>
    </captionLeftItems>

    <menuPane>
        <FXMenuPane fx:id="menuPane">
            <fileTab>
                <FXMenuTab id="file" title="File"/>
            </fileTab>
            <backstageContent>
                <FXBackstageMenuPane fx:id="backstageMenuPane" menuWidth="180.0" styleClass="logo-backstage">
                    <items>
                        <FXBackstageMenuItem text="Info">
                            <content>
                                <VBox spacing="8.0">
                                    <padding>
                                        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
                                    </padding>
                                    <Label text="Info" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                                    <Label text="Click the File tab to open this panel; press Escape or click outside to close."/>
                                </VBox>
                            </content>
                        </FXBackstageMenuItem>
                        <FXBackstageMenuItem text="New">
                            <content>
                                <VBox spacing="8.0">
                                    <padding>
                                        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
                                    </padding>
                                    <Label text="New" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                                    <Label text="Placeholder content for the New menu entry."/>
                                </VBox>
                            </content>
                        </FXBackstageMenuItem>
                        <FXBackstageMenuItem text="Settings">
                            <content>
                                <VBox spacing="8.0">
                                    <padding>
                                        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
                                    </padding>
                                    <Label text="Settings" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                                    <Label text="Placeholder content for the Settings menu entry."/>
                                </VBox>
                            </content>
                        </FXBackstageMenuItem>
                    </items>
                </FXBackstageMenuPane>
            </backstageContent>

            <tabs>
                <FXMenuTab fx:id="home" id="home" title="Home">
                    <groups>
                        <FXMenuGroup title="File">
                            <content>
                                <FXMenuGroupLargeBox fx:id="fileNew">
                                    <Button styleClass="logo-ribbon-button" focusTraversable="false">
                                        <graphic>
                                            <ImageView fitWidth="24.0" fitHeight="24.0" preserveRatio="true">
                                                <Image url="@icons/new-doc-24.png"/>
                                            </ImageView>
                                        </graphic>
                                    </Button>
                                </FXMenuGroupLargeBox>
                                <FXMenuGroupLargeBox priority="HIGH">
                                    <Button styleClass="logo-ribbon-button" focusTraversable="false">
                                        <graphic>
                                            <ImageView fitWidth="24.0" fitHeight="24.0" preserveRatio="true">
                                                <Image url="@icons/folder-24.png"/>
                                            </ImageView>
                                        </graphic>
                                    </Button>
                                </FXMenuGroupLargeBox>
                            </content>
                            <anchor>
                                <fx:reference source="fileNew"/>
                            </anchor>
                        </FXMenuGroup>
                        <FXMenuGroup title="View">
                            <content>
                                <FXMenuGroupLargeBox fx:id="viewList">
                                    <Button styleClass="logo-ribbon-button" focusTraversable="false">
                                        <graphic>
                                            <ImageView fitWidth="24.0" fitHeight="24.0" preserveRatio="true">
                                                <Image url="@icons/list-24.png"/>
                                            </ImageView>
                                        </graphic>
                                    </Button>
                                </FXMenuGroupLargeBox>
                                <FXMenuGroupLargeBox priority="HIGH">
                                    <Button styleClass="logo-ribbon-button" focusTraversable="false">
                                        <graphic>
                                            <ImageView fitWidth="24.0" fitHeight="24.0" preserveRatio="true">
                                                <Image url="@icons/grid-24.png"/>
                                            </ImageView>
                                        </graphic>
                                    </Button>
                                </FXMenuGroupLargeBox>
                            </content>
                            <anchor>
                                <fx:reference source="viewList"/>
                            </anchor>
                        </FXMenuGroup>
                        <FXMenuGroup title="Settings">
                            <content>
                                <FXMenuGroupLargeBox fx:id="settingsOpen">
                                    <Button styleClass="logo-ribbon-button, framed" focusTraversable="false">
                                        <graphic>
                                            <ImageView fitWidth="26.0" fitHeight="26.0" preserveRatio="true">
                                                <Image url="@icons/settings-32.png"/>
                                            </ImageView>
                                        </graphic>
                                    </Button>
                                </FXMenuGroupLargeBox>
                            </content>
                            <anchor>
                                <fx:reference source="settingsOpen"/>
                            </anchor>
                        </FXMenuGroup>
                    </groups>
                </FXMenuTab>

                <FXMenuTab id="view" title="View"/>
                <FXMenuTab id="tools" title="Tools"/>
            </tabs>

            <activeTab>
                <fx:reference source="home"/>
            </activeTab>
        </FXMenuPane>
    </menuPane>

    <VBox styleClass="logo-body">
        <HBox styleClass="logo-split" spacing="16.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="16.0" right="18.0" bottom="18.0" left="18.0"/>
            </padding>
            <VBox styleClass="logo-sidebar" spacing="12.0" minWidth="150.0" prefWidth="160.0">
                <padding>
                    <Insets top="16.0" right="14.0" bottom="16.0" left="14.0"/>
                </padding>
                <Region styleClass="logo-row, active"/>
                <Region styleClass="logo-row"/>
                <Region styleClass="logo-row"/>
                <Region styleClass="logo-row"/>
                <Region styleClass="logo-row"/>
            </VBox>
            <Region styleClass="logo-canvas" HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>
</MenuChromePane>
