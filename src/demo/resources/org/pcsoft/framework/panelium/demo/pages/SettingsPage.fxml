<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      spacing="12.0">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>
    <Label text="Appearance" style="-fx-font-weight: bold;"/>
    <CheckBox text="Show status bar" selected="true"/>
    <CheckBox text="Show tool bar labels" selected="true"/>
    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <Label text="Window opacity"/>
        <Slider min="0.2" max="1.0" value="1.0" showTickMarks="true"/>
    </HBox>
</VBox>
