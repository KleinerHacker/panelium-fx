<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      spacing="14.0" alignment="TOP_LEFT">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>
    <ImageView fitWidth="64.0" fitHeight="64.0" preserveRatio="true">
        <image>
            <Image url="@../icons/app-64.png"/>
        </image>
    </ImageView>
    <Label text="PaneliumStage demo window" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
    <Label text="Undecorated, transparent, with a composable caption bar."/>
    <Label text="Icons in every caption slot, the tool bar, the navigation list and the status bar."/>
</VBox>
