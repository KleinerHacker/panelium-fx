<!--
  MenuChromePane is the ChromePane subclass for MenuPane windows: the FXMenuPane goes into its
  `menuPane` slot (docked below the caption bar) and the window body into `body`. The whole ribbon -
  tabs, groups, layout boxes, file tab and backstage panel - is declared here in FXML; the Stage is
  bootstrapped in MenuPaneShowcaseApp and the controller only wires the dynamic bits (the checkbox
  that toggles the contextual "Table Tools" tabs and the active-tab status label).

  Every ribbon group names an <anchor> box (a FXMenuGroupLarge/SmallBox already in <content>) that
  never collapses; the remaining boxes carry a priority and fold into the group's chevron popup
  lowest-first as the window narrows.
-->
<MenuChromePane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
                fx:controller="org.pcsoft.framework.panelium.demo.MenuPaneShowcaseWindowController"
                prefWidth="720.0" prefHeight="420.0">
    <fx:define>
        <FXMenuTab fx:id="tableDesign" id="table-design" title="Design"/>
        <FXMenuTab fx:id="tableLayout" id="table-layout" title="Layout"/>
    </fx:define>

    <menuPane>
        <FXMenuPane fx:id="menuPane">
            <fileTab>
                <FXMenuTab id="file" title="File"/>
            </fileTab>
            <backstageContent>
                <VBox spacing="8.0" maxWidth="Infinity" maxHeight="Infinity"
                      style="-fx-background-color: #f4f4f4; -fx-border-color: #c8c8c8; -fx-border-width: 1 0 0 0;">
                    <padding>
                        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
                    </padding>
                    <Label text="Backstage" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                    <Label text="Click the File tab to open this panel; press Escape or click outside to close."/>
                </VBox>
            </backstageContent>

            <tabs>
                <FXMenuTab fx:id="home" id="home" title="Home">
                  <groups>
                    <FXMenuGroup title="Clipboard">
                        <content>
                            <FXMenuGroupLargeBox fx:id="clipboardPaste">
                                <Button text="Paste"/>
                            </FXMenuGroupLargeBox>
                            <FXMenuGroupSmallBox priority="HIGH">
                                <Button text="Cut"/>
                                <Button text="Copy"/>
                            </FXMenuGroupSmallBox>
                            <FXMenuGroupSmallBox priority="LOW">
                                <Button text="Format Painter"/>
                                <Button text="Clear"/>
                            </FXMenuGroupSmallBox>
                        </content>
                        <anchor>
                            <fx:reference source="clipboardPaste"/>
                        </anchor>
                    </FXMenuGroup>
                    <FXMenuGroup fx:id="fontGroup" title="Font">
                        <content>
                            <FXMenuGroupSmallBox fx:id="fontFace" priority="HIGH">
                                <Button text="Bold"/>
                                <Button text="Italic"/>
                                <Button text="Underline"/>
                            </FXMenuGroupSmallBox>
                            <FXMenuGroupSmallBox priority="MEDIUM">
                                <Button text="Strikethrough"/>
                                <Button text="Subscript"/>
                            </FXMenuGroupSmallBox>
                            <FXMenuGroupSmallBox priority="LOW">
                                <Button text="Superscript"/>
                                <Button text="Text Color"/>
                                <Button text="Highlight"/>
                            </FXMenuGroupSmallBox>
                        </content>
                        <anchor>
                            <fx:reference source="fontFace"/>
                        </anchor>
                    </FXMenuGroup>
                    <FXMenuGroup title="Paragraph">
                        <content>
                            <FXMenuGroupSmallBox fx:id="paragraphLists">
                                <Button text="Bullets"/>
                                <Button text="Numbering"/>
                                <Button text="Multilevel"/>
                            </FXMenuGroupSmallBox>
                            <FXMenuGroupSmallBox priority="LOW">
                                <Button text="Decrease Indent"/>
                                <Button text="Increase Indent"/>
                            </FXMenuGroupSmallBox>
                            <FXMenuGroupSmallBox priority="LOW">
                                <Button text="Align Left"/>
                                <Button text="Center"/>
                                <Button text="Align Right"/>
                            </FXMenuGroupSmallBox>
                        </content>
                        <anchor>
                            <fx:reference source="paragraphLists"/>
                        </anchor>
                    </FXMenuGroup>
                    <FXMenuGroup title="Styles">
                        <content>
                            <FXMenuGroupLargeBox fx:id="stylesGallery">
                                <Button text="Style Gallery"/>
                            </FXMenuGroupLargeBox>
                            <FXMenuGroupSmallBox priority="MEDIUM">
                                <Button text="Normal"/>
                                <Button text="Heading 1"/>
                                <Button text="Heading 2"/>
                            </FXMenuGroupSmallBox>
                            <FXMenuGroupSmallBox priority="LOW">
                                <Button text="Title"/>
                                <Button text="Subtitle"/>
                            </FXMenuGroupSmallBox>
                        </content>
                        <anchor>
                            <fx:reference source="stylesGallery"/>
                        </anchor>
                    </FXMenuGroup>
                    <FXMenuGroup title="Editing">
                        <content>
                            <FXMenuGroupSmallBox fx:id="editingFind">
                                <Button text="Find"/>
                                <Button text="Replace"/>
                                <Button text="Select"/>
                            </FXMenuGroupSmallBox>
                            <FXMenuGroupSmallBox priority="LOW">
                                <Button text="Go To"/>
                                <Button text="Advanced Find"/>
                            </FXMenuGroupSmallBox>
                        </content>
                        <anchor>
                            <fx:reference source="editingFind"/>
                        </anchor>
                    </FXMenuGroup>
                    <FXMenuGroup title="Insert">
                        <content>
                            <FXMenuGroupLargeBox fx:id="insertTable">
                                <Button text="Table"/>
                            </FXMenuGroupLargeBox>
                            <FXMenuGroupSmallBox priority="LOW">
                                <Button text="Picture"/>
                                <Button text="Shape"/>
                                <Button text="Icon"/>
                            </FXMenuGroupSmallBox>
                            <FXMenuGroupSmallBox priority="LOW">
                                <Button text="Chart"/>
                                <Button text="SmartArt"/>
                            </FXMenuGroupSmallBox>
                        </content>
                        <anchor>
                            <fx:reference source="insertTable"/>
                        </anchor>
                    </FXMenuGroup>
                  </groups>
                </FXMenuTab>

                <FXMenuTab fx:id="view" id="view" title="View">
                  <groups>
                    <FXMenuGroup title="Views">
                        <content>
                            <FXMenuGroupLargeBox fx:id="viewRead">
                                <ToggleButton text="Read"/>
                            </FXMenuGroupLargeBox>
                            <FXMenuGroupLargeBox priority="LOW">
                                <ToggleButton text="Print"/>
                            </FXMenuGroupLargeBox>
                            <FXMenuGroupLargeBox priority="LOW">
                                <ToggleButton text="Web"/>
                            </FXMenuGroupLargeBox>
                        </content>
                        <anchor>
                            <fx:reference source="viewRead"/>
                        </anchor>
                    </FXMenuGroup>
                    <FXMenuGroup title="Show">
                        <content>
                            <FXMenuGroupSmallBox fx:id="showToggles">
                                <CheckBox text="Ruler"/>
                                <CheckBox text="Gridlines"/>
                            </FXMenuGroupSmallBox>
                        </content>
                        <anchor>
                            <fx:reference source="showToggles"/>
                        </anchor>
                    </FXMenuGroup>
                    <FXMenuGroup title="Protected" disable="true">
                        <content>
                            <FXMenuGroupLargeBox fx:id="protectedLocked">
                                <Button text="Locked"/>
                            </FXMenuGroupLargeBox>
                        </content>
                        <anchor>
                            <fx:reference source="protectedLocked"/>
                        </anchor>
                    </FXMenuGroup>
                  </groups>
                </FXMenuTab>

                <FXMenuTab id="tools" title="Tools"/>
                <FXMenuTab id="disabled" title="Disabled" disabled="true"/>
            </tabs>

            <activeTab>
                <fx:reference source="home"/>
            </activeTab>
        </FXMenuPane>
    </menuPane>

    <VBox spacing="16.0" style="-fx-background-color: white;">
        <padding>
            <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
        </padding>
        <CheckBox fx:id="showTableToolsCheckBox" text="Show Table Tools"/>
        <!-- Uncheck to switch the collapse feature off: the chevron disappears, the ribbon is
             forced expanded and the double-click / context-menu triggers go inert. -->
        <CheckBox fx:id="collapsibleCheckBox" text="Collapsible" selected="true"/>
        <Label fx:id="activeTabLabel"/>
        <Label fx:id="launcherLabel" text="Font launcher: not opened yet"/>
        <!-- Collapse/expand: double-click the active tab or use the chevron at the end of the tab
             row. While collapsed, a single click on a tab peeks its groups without expanding. -->
        <Label fx:id="collapsedLabel" text="Ribbon: expanded"/>
        <!-- Ribbon context menu: right-click the tab strip or the group strip for a one-entry
             collapse/expand menu (no wiring needed, it comes with FXMenuPane). -->
        <Label text="Right-click the tab strip or a group for the ribbon's collapse/expand menu."/>
    </VBox>
</MenuChromePane>
