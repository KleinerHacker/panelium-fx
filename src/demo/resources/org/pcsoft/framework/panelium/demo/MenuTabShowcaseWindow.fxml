<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import org.pcsoft.framework.panelium.menutab.FXMenuTab?>
<!--
  Minimal window that renders only FXMenuTab with a handful of demo tabs, no ChromePane or other
  chrome around it, so the component can be inspected visually on its own. Declarative FXML plus a
  controller, mirroring ChromeDemoWindow.fxml / ChromeDemoWindowController - the demo bootstraps
  the Stage in MenuTabShowcaseApp.
-->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.pcsoft.framework.panelium.demo.MenuTabShowcaseWindowController"
      spacing="16.0" style="-fx-background-color: white;">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>

    <FXMenuTab fx:id="menuTab"/>

    <Label fx:id="activeTabLabel"/>
</VBox>
