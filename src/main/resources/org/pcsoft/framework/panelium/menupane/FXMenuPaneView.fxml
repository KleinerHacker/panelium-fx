<fx:root xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         type="javafx.scene.layout.StackPane"
         fx:id="root"
         fx:controller="org.pcsoft.framework.panelium.menupane.FXMenuPaneView">
    <VBox fx:id="bandColumn">
        <HBox fx:id="tabStripRow" alignment="CENTER_LEFT" spacing="2.0">
            <ToggleButton fx:id="fileTabButton" styleClass="menu-pane-strip-file-button"
                          visible="false" managed="false"/>
            <ScrollPane fx:id="tabStripScrollPane" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="NEVER"
                        styleClass="menu-pane-strip-scroll-pane" HBox.hgrow="ALWAYS">
                <HBox fx:id="tabStrip" alignment="CENTER_LEFT" spacing="2.0" styleClass="menu-pane-strip" focusTraversable="true"/>
            </ScrollPane>
            <HBox fx:id="trailingItemsBox" alignment="CENTER_LEFT" spacing="2.0" styleClass="menu-pane-trailing-items"/>
            <ToggleButton fx:id="collapseToggleButton" styleClass="menu-pane-collapse-toggle"
                          contentDisplay="GRAPHIC_ONLY" selected="true" focusTraversable="false"
                          mnemonicParsing="false">
                <graphic>
                    <Region styleClass="menu-pane-collapse-toggle-icon"/>
                </graphic>
            </ToggleButton>
        </HBox>
        <ScrollPane fx:id="groupStripScrollPane" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="NEVER"
                    styleClass="menu-pane-group-strip-scroll-pane">
            <HBox fx:id="groupStrip" alignment="CENTER_LEFT" spacing="4.0" styleClass="menu-pane-group-strip"/>
        </ScrollPane>
    </VBox>
    <StackPane fx:id="backstageContentSlot" visible="false" managed="false"/>
</fx:root>
