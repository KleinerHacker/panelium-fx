<fx:root xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         type="javafx.scene.layout.StackPane"
         fx:id="root"
         fx:controller="org.pcsoft.framework.panelium.menupane.FXMenuGroupView">
    <VBox spacing="2.0">
        <HBox fx:id="overflowRow" alignment="CENTER_LEFT" spacing="2.0" VBox.vgrow="ALWAYS">
            <HBox fx:id="groupContent" alignment="CENTER_LEFT" spacing="2.0" styleClass="menu-group-content"/>
            <Button fx:id="overflowButton" styleClass="menu-group-overflow-button" text="&#187;"
                    focusTraversable="false" visible="false" managed="false"/>
        </HBox>
        <HBox fx:id="titleRow" alignment="CENTER_LEFT" spacing="2.0">
            <Label fx:id="groupTitle" styleClass="menu-group-title" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="launcherButton" styleClass="menu-group-launcher" text="&#x2198;"
                    visible="false" managed="false"/>
        </HBox>
    </VBox>
</fx:root>
