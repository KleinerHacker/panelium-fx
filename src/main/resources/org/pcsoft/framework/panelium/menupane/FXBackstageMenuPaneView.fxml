<fx:root xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         type="javafx.scene.layout.StackPane"
         fx:id="root"
         fx:controller="org.pcsoft.framework.panelium.menupane.FXBackstageMenuPaneView">
    <BorderPane fx:id="layout">
        <left>
            <VBox fx:id="menuArea" styleClass="backstage-menu-pane-menu-area">
                <ListView fx:id="menuListView" styleClass="backstage-menu-pane-list" VBox.vgrow="ALWAYS"/>
            </VBox>
        </left>
        <center>
            <StackPane fx:id="contentArea" styleClass="backstage-menu-pane-content-area"/>
        </center>
    </BorderPane>
</fx:root>
