<FXMenuPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <fx:define>
        <FXMenuTab fx:id="tableDesign" id="table-design" title="Design"/>
    </fx:define>

    <fileTab>
        <FXMenuTab id="file" title="File"/>
    </fileTab>
    <backstageContent>
        <VBox>
            <Label text="Backstage"/>
        </VBox>
    </backstageContent>

    <tabs>
        <FXMenuTab fx:id="home" id="home" title="Home">
            <groups>
                <FXMenuGroup title="Clipboard">
                    <content>
                        <FXMenuGroupLargeBox fx:id="paste">
                            <Button text="Paste"/>
                        </FXMenuGroupLargeBox>
                        <FXMenuGroupSmallBox priority="LOW">
                            <Button text="Cut"/>
                            <Button text="Copy"/>
                        </FXMenuGroupSmallBox>
                    </content>
                    <anchor>
                        <fx:reference source="paste"/>
                    </anchor>
                </FXMenuGroup>
                <FXMenuGroup title="Font" disable="true">
                    <content>
                        <FXMenuGroupSmallBox fx:id="fontFace">
                            <Button text="Bold"/>
                            <Button text="Italic"/>
                        </FXMenuGroupSmallBox>
                        <FXMenuGroupSmallBox priority="LOW">
                            <ToggleButton text="Highlight"/>
                        </FXMenuGroupSmallBox>
                    </content>
                    <anchor>
                        <fx:reference source="fontFace"/>
                    </anchor>
                </FXMenuGroup>
            </groups>
        </FXMenuTab>
        <FXMenuTab id="disabled" title="Disabled" disabled="true"/>
    </tabs>

    <activeTab>
        <fx:reference source="home"/>
    </activeTab>
</FXMenuPane>
